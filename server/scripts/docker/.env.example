# HEI Boot Docker 部署环境变量（复制为 .env 后填写，勿提交 .env）
# cp .env.example .env

# --- 镜像版本（registry.cn-beijing.aliyuncs.com/czbyte，预先 docker build / docker load）---
HEI_BOOT_VERSION=latest
HEI_ADMIN_VERSION=latest
HEI_PORTAL_VERSION=latest

# --- 应用 ---
SERVER_PORT=8000
HEI_ADMIN_PORT=5173
HEI_PORTAL_PORT=5174
SPRING_PROFILES_ACTIVE=prod
SA_TOKEN_COOKIE_SECURE=false
HEI_SECURITY_EXPOSE_ACTUATOR=true
# CLIENT_MAX_BODY_SIZE=10m
# HEI_HSTS_HEADER=
# 裁剪头像 XHR 读 blob: → connect-src 须含 blob:；Banner/外链图 → img-src 建议含 http: https:
# HEI_ADMIN_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
# HEI_PORTAL_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# --- 中间件镜像（默认 czbyte 仓库，可在 .env 覆盖）---
# MYSQL_IMAGE=registry.cn-beijing.aliyuncs.com/czbyte/mysql:9.6.0
# REDIS_IMAGE=registry.cn-beijing.aliyuncs.com/czbyte/redis:8.6.2
# MINIO_IMAGE=registry.cn-beijing.aliyuncs.com/czbyte/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1

# --- MySQL ---
MYSQL_PORT=3306
MYSQL_DATABASE=hei_boot
MYSQL_ROOT_PASSWORD=change-me-mysql-root

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- MinIO ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- hei-boot 数据源 / 缓存 ---
DB_WRITE_URL=jdbc:mysql://mysql:3306/hei_boot?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_WRITE_USERNAME=root
DB_WRITE_PASSWORD=change-me-mysql-root
DB_PASSWORD=change-me-mysql-root
REDIS_HOST=redis

# --- RabbitMQ（OJ 判题队列）---
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=hei
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- OJ 判题 / SparkSandbox 双向 HMAC（须与沙箱 SPARK_SANDBOX_SIGNING_SECRET 相同）---
OJ_JUDGE_DEFAULT_SIGNING_SECRET=your-long-random-secret

# 与 scripts/db.sql sys_config 密文一致（演示种子）
HEI_CONFIG_CRYPTO_KEY=change-me-fernet-key

JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

Nacos:
  ServerAddr: "<DEV_HOST>:8848"
  Username: "nacos"
  Password: "change-me"
  Namespace: "8fee08f3-44ea-4e26-a9b5-530c582330a3"
  Group: "DEFAULT_GROUP"
  DataId: "service-judge.yaml"

Name: service-judge
Host: 0.0.0.0
Port: 8888

# 复制为 judge-dev.yaml 后填写共享开发机；judge-dev.yaml 不会被 git 提交
#   cp etc/judge-dev.yaml.example etc/judge-dev.yaml

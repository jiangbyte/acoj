# ============================================================================
# hei-fastapi environment example
# 说明：
# 1. 配置使用双下划线 `__` 做嵌套分组，例如 `APP__PORT`
# 2. PostgreSQL 与 Redis 是运行必需依赖；RabbitMQ、S3/MinIO、可观测性按需启用
# 3. 可观测性为可选开启，默认关闭，不强依赖 Prometheus / OTel / 额外 agent
# ============================================================================

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
APP__NAME=hei-fastapi
APP__HOST=0.0.0.0
APP__PORT=8000
APP__DEBUG=true
APP__WORKERS=1
APP__WORKER_MAX=4
APP__CONFIG_CRYPTO_KEY=XV1rJ-UPAbWeYjprihKNS3ZCCHdBuVbIc0WXmYc70ck=
APP__TIMEZONE=Asia/Shanghai

CORS__ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5163","http://127.0.0.1:5163","http://localhost:5174","http://127.0.0.1:5174","http://192.168.113.65:5174"]

# ----------------------------------------------------------------------------
# DATABASE
# PostgreSQL + asyncpg
# ----------------------------------------------------------------------------
DB__URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/hei_fastapi
DB__ECHO=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_TIMEOUT_SECONDS=30
DB__POOL_RECYCLE_SECONDS=1800
DB__POOL_PRE_PING=true

# ----------------------------------------------------------------------------
# AUDIT
# ----------------------------------------------------------------------------
AUDIT__OPERATION_QUEUE_SIZE=1000
AUDIT__OPERATION_SHUTDOWN_TIMEOUT_SECONDS=5

# ----------------------------------------------------------------------------
# REDIS
# 说明：
# - Redis 是会话存储、权限注册表和授权缓存的必需依赖
# - 密码通过 URL 传递，例如：redis://:123456@127.0.0.1:6379/0
# ----------------------------------------------------------------------------
REDIS__URL=redis://:123456@127.0.0.1:6379/3
REDIS__MAX_CONNECTIONS=1000

# ----------------------------------------------------------------------------
# AUTH
# 说明：
# - token 使用随机字符串
# - 会话统一写入 Redis，多副本部署共享同一会话状态
# ----------------------------------------------------------------------------
AUTH__TOKEN_NAME=Authorization
# 以下 AUTH 配置已迁移至 sys_config 表，可通过管理后台修改：
# AUTH__TOKEN_TTL_SECONDS, AUTH__REFRESH_TTL_SECONDS,
# AUTH__ADMIN_REGISTER_ENABLED, AUTH__PORTAL_REGISTER_ENABLED,
# AUTH__LOGIN_FAILURE_WINDOW_SECONDS, AUTH__LOGIN_ACCOUNT_MAX_FAILURES,
# AUTH__LOGIN_IP_MAX_FAILURES, AUTH__LOGIN_LOCK_SECONDS,
# AUTH__PASSWORD_RESET_TOKEN_TTL_SECONDS

# ----------------------------------------------------------------------------
# MAIL
# ----------------------------------------------------------------------------
MAIL__HOST=
MAIL__PORT=587
MAIL__USERNAME=
MAIL__PASSWORD=
MAIL__FROM_EMAIL=
MAIL__FROM_NAME=hei-fastapi
MAIL__USE_TLS=true
MAIL__TIMEOUT_SECONDS=10
MAIL__PASSWORD_RESET_URL=http://localhost:5173/auth/forgot-password

# ----------------------------------------------------------------------------
# CELERY / RABBITMQ — 由 entrypoint.sh 启动 worker 和 beat
# ----------------------------------------------------------------------------
CELERY__BROKER_URL=amqp://admin:123456@127.0.0.1:5672//
CELERY__WORKER_WITHOUT_MINGLE=true
CELERY__WORKER_WITHOUT_GOSSIP=true
CELERY__WORKER_REMOTE_CONTROL_ENABLED=false
CELERY__WORKER_CANCEL_LONG_RUNNING_TASKS_ON_CONNECTION_LOSS=true

# ----------------------------------------------------------------------------
# STORAGE
# 说明：
# - 默认使用 S3 兼容存储，适配 AWS S3 / MinIO
# - 轻量部署或本地开发可切换为 local，避免依赖对象存储服务
# ----------------------------------------------------------------------------
# 以下 STORAGE 配置已全部迁移至 sys_config 表，可通过管理后台修改：
# STORAGE__PROVIDER, STORAGE__BUCKET, STORAGE__ENDPOINT, STORAGE__ACCESS_KEY,
# STORAGE__SECRET_KEY, STORAGE__REGION, STORAGE__USE_SSL,
# STORAGE__PRESIGN_EXPIRE_SECONDS, STORAGE__BASE_URL, STORAGE__PUBLIC_PATH,
# STORAGE__LOCAL_ROOT, STORAGE__UPLOAD_MAX_BYTES, STORAGE__PUBLIC_UPLOAD_ENABLED,
# STORAGE__UPLOAD_ALLOWED_CONTENT_TYPES, STORAGE__UPLOAD_ALLOWED_EXTENSIONS,
# STORAGE__UPLOAD_DENIED_EXTENSIONS, STORAGE__UPLOAD_CATEGORY_MAX_LENGTH

# ----------------------------------------------------------------------------
# SNOWFLAKE ID
# 说明：
# - 主键使用雪花 ID 字符串
# - worker_id / datacenter_id 在多实例部署时应避免重复
# ----------------------------------------------------------------------------
ID_GENERATOR__WORKER_ID=1
ID_GENERATOR__DATACENTER_ID=1

# ----------------------------------------------------------------------------
# SWAGGER
# ----------------------------------------------------------------------------
SWAGGER__ENABLED=true

# ----------------------------------------------------------------------------
# OBSERVABILITY
# 说明：
# - 默认关闭，适合轻量部署或极简部署
# - 开启总开关后，再按需打开日志 JSON、metrics、tracing、OTLP 导出
# - 若只想保留普通日志，可继续保持 OBSERVABILITY__ENABLED=false
# ----------------------------------------------------------------------------
OBSERVABILITY__ENABLED=false
OBSERVABILITY__SERVICE_NAME=hei-fastapi
OBSERVABILITY__SERVICE_VERSION=0.1.0
OBSERVABILITY__ENVIRONMENT=dev
OBSERVABILITY__LOG_ENABLED=true
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_JSON=false
OBSERVABILITY__LOG_DIR=logs
OBSERVABILITY__LOG_FILE_MAX_MB=100
OBSERVABILITY__METRICS_ENABLED=false
OBSERVABILITY__METRICS_PATH=/metrics
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=
OBSERVABILITY__SAMPLE_RATIO=1.0
OBSERVABILITY__CELERY_OBSERVABILITY_ENABLED=false
OBSERVABILITY__DB_OBSERVABILITY_ENABLED=false
OBSERVABILITY__HTTP_CLIENT_OBSERVABILITY_ENABLED=false

# ----------------------------------------------------------------------------
# Profile Example: Local Development
# ----------------------------------------------------------------------------
# REDIS__URL=redis://127.0.0.1:6379/0
# STORAGE__PROVIDER=local
# OBSERVABILITY__ENABLED=false

# ----------------------------------------------------------------------------
# Profile Example: Full Environment
# ----------------------------------------------------------------------------
# REDIS__URL=redis://127.0.0.1:6379/0
# STORAGE__PROVIDER=s3
# OBSERVABILITY__ENABLED=true
# OBSERVABILITY__LOG_JSON=true
# OBSERVABILITY__METRICS_ENABLED=true
# OBSERVABILITY__TRACING_ENABLED=true
# OBSERVABILITY__OTLP_ENABLED=true
# OBSERVABILITY__OTLP_ENDPOINT=http://127.0.0.1:4318
# OBSERVABILITY__DB_OBSERVABILITY_ENABLED=true
# OBSERVABILITY__HTTP_CLIENT_OBSERVABILITY_ENABLED=true
# OBSERVABILITY__CELERY_OBSERVABILITY_ENABLED=true

# ----------------------------------------------------------------------------
# 等保 SECURITY HARDENING (新增)
# ----------------------------------------------------------------------------
# 会话管理
AUTH__TOKEN_TTL_SECONDS=14400
AUTH__SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH__SESSION_BIND_IP=true
AUTH__MAX_CONCURRENT_SESSIONS=5
# 密码策略
PASSWORD_POLICY__MIN_LENGTH=8
PASSWORD_POLICY__REQUIRE_UPPERCASE=true
PASSWORD_POLICY__REQUIRE_LOWERCASE=true
PASSWORD_POLICY__REQUIRE_DIGIT=true
PASSWORD_POLICY__REQUIRE_SPECIAL=true
PASSWORD_POLICY__EXPIRE_DAYS=90
PASSWORD_POLICY__HISTORY_CHECK_COUNT=5
PASSWORD_POLICY__COMMON_PASSWORD_CHECK=true

# ----------------------------------------------------------------------------
# AUDIT ALERT (审计告警配置)
# ----------------------------------------------------------------------------
# AUDIT_ALERT__ENABLED=false
# AUDIT_ALERT__WEBHOOK_URL=
# AUDIT_ALERT__ANALYSIS_INTERVAL_SECONDS=300
# AUDIT_ALERT__ALERT_COOLDOWN_SECONDS=1800
# AUDIT_ALERT__RULE_BRUTE_FORCE=true
# AUDIT_ALERT__RULE_UNUSUAL_HOURS=true
# AUDIT_ALERT__RULE_SENSITIVE_OPS=true
# AUDIT_ALERT__RULE_BULK_DELETE=true
# AUDIT_ALERT__RULE_IP_ANOMALY=true
# AUDIT_ALERT__BRUTE_FORCE_THRESHOLD=10
# AUDIT_ALERT__BULK_DELETE_THRESHOLD=20
# AUDIT_ALERT__IP_ANOMALY_THRESHOLD=3

# hei-fastapi local environment
#
# This file keeps deployment/infrastructure settings only.
# Runtime business settings are managed in DB:
# - mail.* and storage.upload_*: sys_config
# - storage provider/endpoint/bucket/access keys: sys_storage_config

APP__HOST=0.0.0.0
APP__PORT=8000
APP__DEBUG=true
APP__PROCESS_ROLE=all
APP__CONFIG_CRYPTO_KEY=XV1rJ-UPAbWeYjprihKNS3ZCCHdBuVbIc0WXmYc70ck=
APP__TIMEZONE=Asia/Shanghai
APP__TRUSTED_PROXY_IPS=[]

CORS__ALLOW_ORIGINS=["*","http://127.0.0.1:5173","http://localhost:5163","http://127.0.0.1:5163","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5176","http://127.0.0.1:5176"]

DB__URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/hei_fastapi
# Redis DBs: /3 API cache+result, /1 Celery broker (shared with worker), /0 worker cache
REDIS__URL=redis://:123456@127.0.0.1:6379/3
CELERY__BROKER_URL=redis://:123456@127.0.0.1:6379/1
CELERY__BROKER_VISIBILITY_TIMEOUT=3600
CELERY__WORKER_POOL=threads
CELERY__WORKER_CONCURRENCY=16

AUTH__SESSION_IDLE_TIMEOUT_SECONDS=1800

# ACOJ local / single-node defaults (4C8G)
# Aligned with deploy/nacos_config_export.zip credentials.
# Copy to .env and adjust if needed:  cp .env.example .env

MYSQL_ROOT_PASSWORD=infra@123
MYSQL_DATABASE=astro_code
MYSQL_PORT=3306

REDIS_PASSWORD=infra@123
REDIS_PORT=6379

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=infra@123
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_PORT=8848
# Required for SCA 2025 (nacos-client 3.x) against Nacos 2.5 (empty public ≠ "public")
NACOS_NAMESPACE=8fee08f3-44ea-4e26-a9b5-530c582330a3
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=infra@123
MINIO_BUCKET=astro-code-oj
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OJ_PORT=89
JUDGE_PORT=8888
SIM_PORT=8882
PC_PORT=80
ADMIN_PORT=81

JUDGE_GOMAXPROCS=2
JUDGE_GOMEMLIMIT=512MiB
SIM_GOMAXPROCS=1
SIM_GOMEMLIMIT=384MiB

# Optional LLM (DashScope). Prefer setting the key in Nacos oj.yaml.
DASHSCOPE_API_KEY=

# ACOJ Compose defaults.
# Aligned with deploy/nacos_config_export.zip credentials.
# Copy to .env and adjust if needed:  cp .env.example .env

MYSQL_ROOT_PASSWORD=infra123!
MYSQL_DATABASE=astro_code
MYSQL_PORT=3306

REDIS_PASSWORD=infra123!
REDIS_PORT=6379

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=infra123!
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_PORT=8848
# Required for SCA 2025 (nacos-client 3.x) against Nacos 2.5 (empty public ≠ "public")
NACOS_NAMESPACE=8fee08f3-44ea-4e26-a9b5-530c582330a3
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789

# Silo（MinIO 兼容）；凭证仍走 MINIO_* 环境变量
# 对外访问地址写在 Nacos common.yaml 的 system.storage.minio.access-url（默认 http://localhost:9000）
SILO_IMAGE=pgsty/silo:RELEASE.2026-08-06T00-00-00Z
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=infra123!
MINIO_BUCKET=astro-code-oj
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SYSTEM_PORT=89
JUDGE_PORT=8888
SIMILARITY_PORT=8882
PC_PORT=80
ADMIN_PORT=81

# Frontend build-time API gateway（docker compose build pc/admin 时生效）
VITE_GATEWAY=http://localhost:89

# 与 GHCR 同名；本地构建：docker compose up -d --build（不拉远程）
SYSTEM_IMAGE=ghcr.io/jiangbyte/acoj-service-system:latest
JUDGE_IMAGE=ghcr.io/jiangbyte/acoj-service-judge:latest
SIMILARITY_IMAGE=ghcr.io/jiangbyte/acoj-service-similarity:latest
PC_IMAGE=ghcr.io/jiangbyte/acoj-pc:latest
ADMIN_IMAGE=ghcr.io/jiangbyte/acoj-admin:latest
# build=只用本地构建；确认后再 make docker-push
PULL_POLICY=build

JUDGE_GOMAXPROCS=2
JUDGE_GOMEMLIMIT=384MiB
SIMILARITY_GOMAXPROCS=1
SIMILARITY_GOMEMLIMIT=256MiB

# Optional LLM (DashScope). Prefer setting the key in Nacos service-system.yaml.
DASHSCOPE_API_KEY=
